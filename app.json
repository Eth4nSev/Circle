{
	"expo": {
		"name": "Circle",
		"slug": "Circle",
		"version": "0.2.0",
		"orientation": "portrait",
		"icon": "./assets/images/icon.png",
		"scheme": "circle",
		"userInterfaceStyle": "automatic",
		"newArchEnabled": true,
		"ios": {
			"supportsTablet": true,
			"infoPlist": {
				"NSFaceIDUsageDescription": "This app requires Face ID to secure your private dashboard.",
				"ITSAppUsesNonExemptEncryption": false
			},
			"bundleIdentifier": "com.coolman0771.Circle"
		},
		"android": {
			"adaptiveIcon": {
				"backgroundColor": "#E6F4FE",
				"foregroundImage": "./assets/images/android-icon-foreground.png",
				"backgroundImage": "./assets/images/android-icon-background.png",
				"monochromeImage": "./assets/images/android-icon-monochrome.png"
			},
			"edgeToEdgeEnabled": true,
			"predictiveBackGestureEnabled": false,
			"permissions": [
				"android.permission.USE_BIOMETRIC",
				"android.permission.USE_FINGERPRINT"
			]
		},
		"web": {
			"output": "static",
			"favicon": "./assets/images/favicon.png"
		},
		"plugins": [
			"expo-router",
			[
				"expo-splash-screen",
				{
					"image": "./assets/images/splash-icon.png",
					"imageWidth": 200,
					"resizeMode": "contain",
					"backgroundColor": "#ffffff",
					"dark": {
						"backgroundColor": "#000000"
					}
				}
			],
			[
				"expo-local-authentication",
				{
					"faceIDPermission": "Allow this app to use Face ID."
				}
			],
			"expo-font",
			"expo-image",
			"expo-status-bar",
			"expo-web-browser",
			"expo-asset"
		],
		"experiments": {
			"typedRoutes": true,
			"reactCompiler": true
		},
		"extra": {
			"router": {},
			"eas": {
				"projectId": "265c2722-8bca-43db-a5fa-0de1960a553a"
			}
		}
	}
}
